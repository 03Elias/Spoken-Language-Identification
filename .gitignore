# Python
__pycache__/
*.pyc
.venv/
venv/

# Do not push dataset/audio files
src/data/raw/**/*.mp3
src/data/raw/**/*.wav
src/data/raw/**/*.zip
src/data/raw/**/*.tar.gz
src/data/raw/**/*.tsv

src/data/processed/**/*.wav
src/data/processed/**/*.mp3

# Keep folder structure
!src/data/
!src/data/raw/
!src/data/raw/**/
!src/data/raw/**/.gitkeep
!src/data/processed/
!src/data/processed/**/
!src/data/processed/**/.gitkeep
!src/data/metadata/
!src/data/metadata/.gitkeep

# Logs
logs/
*.log

# OS/editor
.DS_Store
.vscode/

# Ignore NumPy dataset artifacts generated by MFCC pipeline
# Project-specific and generic dataset array patterns
src/mfcc_system/*.npy
**/X_*.npy
**/y_*.npy

# Ignore metadata CSV files (all_metadata, train/test/val)
src/data/metadata/*.csv
**/all_metadata.csv
**/test.csv
**/train.csv
**/val.csv